# 复制为 .env 后按需填写；.env 不得提交。

# 服务端（P3 起使用）
PORT=3100
DATABASE_URL=postgres://battle@127.0.0.1:5433/battle
# 至少 32 字符的随机串，用于签发后台 JWT
JWT_SECRET=
# 32 字节随机串的 base64，用于加密存储模型供应商 API Key
SECRET_KEY=
# 仅在管理员表为空时用于创建首个账号，首次登录必须改密
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 部署在可信反向代理（nginx 等）之后设为 true：限流来源取 X-Forwarded-For；直连公网时保持 false
TRUST_PROXY=false
# 公开对局多少分钟无人确认视为无人观看（不再计入进行中数量，并被自动结束）
MATCH_IDLE_MINUTES=30
# 一个 AI 任务最多领取几次：执行或推进反复失败时终止对局，不再重复付费调用模型
AI_TASK_MAX_ATTEMPTS=3
# 播放流等待新事件时的兜底重查间隔（毫秒）；其他实例的事件经 PostgreSQL LISTEN/NOTIFY 即时送达，这只是通知丢失（监听连接重连期间）时的安全网
STREAM_POLL_MS=2000
# 优雅关闭时最多等待进行中的 AI 任务多少毫秒；超时后直接退出，未完成的任务领取过期后会被重新领取
SHUTDOWN_TIMEOUT_MS=10000

# TTS（P4 起使用）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
MIMO_API_KEY=
MIMO_BASE_URL=

# 本机开发数据库端口（docker-compose.dev.yml）
BATTLE_DB_PORT=5433
