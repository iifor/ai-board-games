# Azure Speech TTS
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastasia
AZURE_SPEECH_ENDPOINT=https://eastasia.api.cognitive.microsoft.com/

# MiMo TTS
MIMO_API_KEY=your-mimo-api-key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_FORMAT=mp3
MIMO_TTS_VOICE=your-mimo-voice-id

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Database model provider
DATABASE_MODEL_API_KEY=your-model-provider-api-key

# PostgreSQL 16 (the application database must already exist)
DATABASE_URL=postgresql://consensus_app:replace-password@postgres.example.com:5432/consensus
DATABASE_SCHEMA=consensus
DATABASE_SSL=require
DATABASE_CA_PATH=/run/secrets/postgres-ca.crt
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# JWT authentication and first administrator bootstrap (B端管理后台登录)
# These credentials create one administrator only when admin_users is empty.
# Once an administrator exists, changing them does not overwrite any account.
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-your-initial-password-at-least-12-characters

# Stable Docker Compose resource names
COMPOSE_PROJECT_NAME=consensus

# Single-process concurrency limits
MAX_CONCURRENT_GAMES=5
MAX_CONCURRENT_LLM_REQUESTS=8
MAX_CONCURRENT_TTS_REQUESTS=4
