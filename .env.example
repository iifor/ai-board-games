# 复制为 .env 后按需填写；.env 不得提交。

# 服务端（P3 起使用）
PORT=3001
DATABASE_URL=postgres://battle@127.0.0.1:5432/battle
# 至少 32 字符的随机串，用于签发后台 JWT
JWT_SECRET=
# 32 字节随机串的 base64，用于加密存储模型供应商 API Key
SECRET_KEY=
# 仅在管理员表为空时用于创建首个账号，首次登录必须改密
ADMIN_USERNAME=
ADMIN_PASSWORD=

# TTS（P4 起使用）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
MIMO_API_KEY=
MIMO_BASE_URL=

# 本机开发数据库端口（docker-compose.dev.yml）
BATTLE_DB_PORT=5432
