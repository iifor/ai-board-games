{
  "name": "@ai-presenter/shared",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/typescript/lib/tsc.js",
    "check": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/typescript/lib/tsc.js --noEmit"
  },
  "exports": {
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/types/*.js"
    },
    "./schemas/*": {
      "types": "./dist/schemas/*.d.ts",
      "default": "./dist/schemas/*.js"
    },
    "./constants/*": {
      "types": "./dist/constants/*.d.ts",
      "default": "./dist/constants/*.js"
    },
    "./vite-plugins/*": "./vite-plugins/*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
