{
  "name": "ai-board-games",
  "private": true,
  "description": "通用 AI 对战平台",
  "type": "module",
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "check": "pnpm -r run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "dev:seed": "node scripts/dev/seed-demo.mjs",
    "dev:import-legacy": "node scripts/dev/import-legacy.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
